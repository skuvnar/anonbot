# Copy to .env and fill in. Never commit the real file.

# Bot token from the Discord developer portal.
DISCORD_TOKEN=

# Right-click the server and the target channel with Developer Mode on to copy these.
ANON_GUILD_ID=
ANON_CHANNEL_ID=

# Channel settings -> Integrations -> Webhooks -> New Webhook, in the same channel.
# Posts go out through it. Treat the URL like the token.
ANON_WEBHOOK_URL=

# Optional. ID of the role whose holders can /silence a Human until midnight UTC.
# Leave it out and nobody can.
# ANON_SILENCE_ROLE_ID=

# Optional. Names people may ping by typing @name in the form, as name:id pairs
# separated by commas. @everyone and @here always work; nobody else can be
# pinged. Meant for making a bot of your own summonable.
# ANON_PING_USERS=
# ANON_PING_ROLES=

# Optional. Where Discord fetches the avatars from. The Docker build sets this
# to the repository's avatars/ folder at the built commit; leave it out to use
# the webhook's own avatar for every post.
# ANON_AVATAR_BASE=

# Optional. Defaults shown.
MAX_MESSAGE_CHARS=2000
RATE_LIMIT_BURST=5
RATE_LIMIT_PER_MINUTE=12

# Copy to .env and fill in. Never commit the real file.

# Bot token from the Discord developer portal.
DISCORD_TOKEN=

# Right-click the server and the target channel with Developer Mode on to copy these.
ANON_GUILD_ID=
ANON_CHANNEL_ID=

# Channel settings -> Integrations -> Webhooks -> New Webhook, in the same channel.
# Posts go out through it. Treat the URL like the token.
ANON_WEBHOOK_URL=

# Optional. Defaults shown.
MAX_MESSAGE_CHARS=2000
RATE_LIMIT_BURST=5
RATE_LIMIT_PER_MINUTE=12
